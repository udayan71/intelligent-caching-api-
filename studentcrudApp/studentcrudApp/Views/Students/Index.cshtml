@model List<StudentCrudApp.Models.Student>

@{
    ViewData["Title"] = "Students List";
}

<h2>Students List</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add New Student</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Age</td>
                <td>
                    <a class="btn btn-info btn-sm" href="@Url.Action("Details", new { id = s.Id })">Details</a>
                    <a class="btn btn-warning btn-sm" href="@Url.Action("Edit", new { id = s.Id })">Edit</a>
                    <a class="btn btn-danger btn-sm" href="@Url.Action("Delete", new { id = s.Id })">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>