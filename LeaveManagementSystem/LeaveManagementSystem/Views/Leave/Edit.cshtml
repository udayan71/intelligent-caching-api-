@model LeaveManagementSystem.Models.LeaveRequest

@using (Html.BeginForm())
{
    @Html.TextBoxFor(x => x.EmployeeName)
    @Html.TextBoxFor(x => x.LeaveType)
    @Html.TextBoxFor(x => x.FromDate)
    @Html.TextBoxFor(x => x.ToDate)
    @Html.TextBoxFor(x => x.Reason)

    <input type="submit" value="Save" />
}