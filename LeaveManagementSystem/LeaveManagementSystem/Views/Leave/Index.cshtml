@model IEnumerable<LeaveManagementSystem.Models.LeaveRequest>

<h2>Leave List</h2>

@using (Html.BeginForm())
{
    <input type="text" name="search" />
    <input type="submit" value="Search" />
}

<table class="table">
    <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Action</th>
    </tr>



<h2 class="mb-3">Leave List</h2>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">
        @TempData["msg"]
    </div>
}

<div class="mb-3">
    @using (Html.BeginForm("Index", "Leave", FormMethod.Get))
    {
        <div class="row">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Search by Employee Name" />
            </div>
            <div class="col-md-2">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
            <div class="col-md-2">
                <a href="/Leave/Create" class="btn btn-success">Add Leave</a>
            </div>
        </div>
    }
</div>

<table class="table table-bordered table-striped">
 

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeName</td>
                <td>@item.LeaveType</td>
                <td>@item.FromDate.ToShortDateString()</td>
                <td>@item.ToDate.ToShortDateString()</td>
                <td>@item.Reason</td>
                <td>
                    <a href="/Leave/Edit/@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/Leave/Delete/@item.Id" class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this record?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</table>